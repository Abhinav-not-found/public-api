{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend for api response",
  "main": "src/server.js",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "tsx --watch src/server.ts",
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts",
    "generate:client": "npm run generate:openapi && openapi --input src/generated/openapi.json --output ../client/src/api --client axios"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.22",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-typescript-codegen": "^0.31.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
